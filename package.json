    "benchmark:sdk": "npm run build && node scripts/benchmark-agent-sdk.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@modelcontextprotocol/sdk": "^1.32.1",
